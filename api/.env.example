DATABASE_URL="mysql://root:change_me@127.0.0.1:3306/szr3"
JWT_SECRET="szr3-dev-secret-change-in-production"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# 起零数据 · 全平台短视频解析 V2
# https://api.istero.com/service/doc/video-parser-v2
ISTERO_API_TOKEN=your_token_here
ISTERO_APP_SECRET=

# HeyGem / Duix-Avatar GPU 服务（ASR + TTS + 视频生成）
# 智星云等环境建议保持 SSH 隧道（默认 true），无需对外开放 8383 等端口
DUIX_USE_SSH_TUNNEL=true
DUIX_GPU_HOST=your-gpu-host
DUIX_VIDEO_API=http://127.0.0.1:8383
DUIX_TTS_API=http://127.0.0.1:18180
DUIX_ASR_WS=ws://127.0.0.1:10095
# 本地隧道端口（DUIX_USE_SSH_TUNNEL=true 时自动使用）
# DUIX_TUNNEL_VIDEO_PORT=18383
# DUIX_TUNNEL_TTS_PORT=18181
# DUIX_TUNNEL_ASR_PORT=10096

# GPU SSH（用于上传音频/参考视频、下载成片）
GPU_SSH_HOST=your-gpu-host
GPU_SSH_PORT=22
GPU_SSH_USER=root
GPU_SSH_PASSWORD=your_gpu_ssh_password
DUIX_FACE2FACE_REMOTE_DIR=/root/duix_avatar_data/face2face
DUIX_VOICE_REMOTE_DIR=/root/duix_avatar_data/voice/data

# HeyGem 克隆音配置（preprocess_and_tran 训练后的相对路径，位于 voice/data 下）
# DUIX_VOICE_001_REFERENCE_AUDIO=origin_audio/your_voice.wav
# DUIX_VOICE_001_REFERENCE_TEXT=参考音频对应的文本

# 本地存储 & 公开访问地址
STORAGE_ROOT=./storage
API_PUBLIC_URL=http://localhost:3001
MEDIA_RETENTION_DAYS=30
VIRUS_SCAN_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# FFmpeg（可选，默认从 PATH 读取；Windows 可用项目 tools/ffmpeg）
# FFMPEG_PATH=e:/Project/Szr3/tools/ffmpeg/ffmpeg.exe
# FFPROBE_PATH=e:/Project/Szr3/tools/ffmpeg/ffprobe.exe

# 长任务队列（可选，不配置则使用内置异步 Worker）
# REDIS_URL=redis://127.0.0.1:6379

# ShuaiAPI 中转 · DeepSeek（文案仿写 / 标题）
SHUAIAPI_BASE_URL=https://api.shuaiapi.com/v1
SHUAIAPI_API_KEY=your_shuaiapi_key
SHUAIAPI_LLM_MODEL=deepseek-v4-flash
