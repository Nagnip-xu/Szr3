{
  "name": "szr3-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "repair:https": "node --env-file=.env scripts/repair-https.mjs",
    "build": "nest build",
    "test": "npm run build && node --test test/*.test.cjs",
    "start": "nest start",
    "start:dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/src/main.js\"",
    "start:prod": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "bootstrap:voice": "node --env-file=.env scripts/bootstrap-default-voice.mjs",
    "bootstrap:avatars": "node --env-file=.env scripts/bootstrap-default-avatars.mjs",
    "sync:avatar-previews": "node --env-file=.env scripts/sync-preset-avatar-previews.mjs",
    "remove:builtin-avatars": "node --env-file=.env scripts/remove-builtin-avatars.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.40.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "file-type": "^20.5.0",
    "ioredis": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2-sftp-client": "^12.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.9",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true
  }
}
